# ─────────────────────────────────────────────────────────────
# Copy to backend/.env and adjust. Everything is optional in development:
# SQLite + a locally generated JWT secret + demo seeding are used by default.
# ─────────────────────────────────────────────────────────────

# "development" (default) or "production".
# In production: JWT_SECRET is required, demo seeding and API docs are off,
# and no CORS origin is allowed until BACKEND_CORS_ORIGINS is set.
ENVIRONMENT=development

# Database — SQLite by default, PostgreSQL for real deployments
DATABASE_URL=sqlite:///./smart_exam.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_exam_db

# JWT — REQUIRED in production, min 32 characters
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute

# Demo data / accounts
# Demo seeding (5 teachers, 5 students, 5 exams, 125 graded answers) is on in
# development and off in production. Demo users share DEMO_PASSWORD.
SEED_DEMO_DATA=
DEMO_PASSWORD=123456
ADMIN_EMAIL=admin@smartexam.com
# Leave empty to have a random admin password generated (and logged once)
ADMIN_PASSWORD=
# Fixed password for CSV bulk import; leave empty for random per-user passwords
BULK_IMPORT_PASSWORD=

# API docs (/docs, /redoc) — default: on in development, off in production
ENABLE_DOCS=

# CORS — explicit origins only, comma-free JSON list
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Uploaded files are served through the authenticated /api/files endpoint.
# Set true only when the host already protects the uploads directory.
UPLOADS_PUBLIC=false
UPLOAD_DIR=

# NLP
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# Remote LanguageTool server, e.g. http://localhost:8010 — empty = local Java process
LANGUAGE_TOOL_URL=
LANGUAGE_TOOL_LANGUAGE=en-US

# AI-generated-text detection (needs requirements-ai.txt; falls back to heuristics)
AI_LM_ENABLED=true
AI_MODEL=distilgpt2
AI_MAX_TOKENS=512
AI_FLAG_THRESHOLD=0.45
AI_REVIEW_THRESHOLD=0.25

# Plagiarism detection
PLAGIARISM_EMBEDDINGS_ENABLED=true
# Semantic similarity is reported as a review signal; only lexical similarity flags
PLAGIARISM_SEMANTIC_REVIEW_GATE=0.90
PLAGIARISM_SEMANTIC_CORROBORATION_GATE=0.92

# Scoring weights (must sum to 1.0)
KEYWORD_WEIGHT=0.30
SIMILARITY_WEIGHT=0.40
GRAMMAR_WEIGHT=0.15
COMPLETENESS_WEIGHT=0.15

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SENTRY_DSN=
